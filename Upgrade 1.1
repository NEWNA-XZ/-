-- =================================================================
-- PART 5: ESP RENDERING FUNCTIONS & MAIN RENDERSTEPPED LOOP
-- =================================================================
local function CreateESPForPlayer(plr)
    if not Drawing then return end
    local objects = {
        Box = Drawing.new("Square"),
        BoxOutline = Drawing.new("Square"),
        HealthBG = Drawing.new("Square"),
        HealthFill = Drawing.new("Square"),
        Tracer = Drawing.new("Line")
    }
    objects.Box.Color = Color3.fromRGB(255, 50, 50)
    objects.Box.Thickness = 1.5
    objects.BoxOutline.Color = Color3.fromRGB(0, 0, 0)
    objects.BoxOutline.Thickness = 3
    objects.HealthBG.Color = Color3.fromRGB(20, 20, 20)
    objects.HealthBG.Filled = true
    objects.HealthFill.Color = Color3.fromRGB(0, 255, 0)
    objects.HealthFill.Filled = true
    objects.Tracer.Thickness = 1.5
    ESP_Objects[plr] = objects
end

local function RemoveESPForPlayer(plr)
    if ESP_Objects[plr] then
        for _, obj in pairs(ESP_Objects[plr]) do obj:Remove() end
        ESP_Objects[plr] = nil
    end
end

local function UpdateESP(plr)
    if not Drawing then return end
    if not ESP_Objects[plr] then CreateESPForPlayer(plr) end
    local objs = ESP_Objects[plr]
    local char = plr.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local head = char and char:FindFirstChild("Head")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")

    if char then
        local highlight = char:FindFirstChild("YellowHighlight")
        if Highlight_Enabled then
            if not highlight then
                highlight = Instance.new("Highlight")
                highlight.Name = "YellowHighlight"
                highlight.FillColor = Color3.fromRGB(255, 230, 0)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 0)
                highlight.FillTransparency = 0.6
                highlight.Parent = char
            end
        else
            if highlight then highlight:Destroy() end
        end
    end

    if char and hrp and head and humanoid and humanoid.Health > 0 then
        local headWorldPos = head.Position + Vector3.new(0, 1.2, 0)
        local legWorldPos = hrp.Position - Vector3.new(0, 3.2, 0)

        local headScreen, headOnScreen = Camera:WorldToViewportPoint(headWorldPos)
        local legScreen, legOnScreen = Camera:WorldToViewportPoint(legWorldPos)

        if headOnScreen or legOnScreen then
            local boxHeight = math.abs(headScreen.Y - legScreen.Y)
            local boxWidth = boxHeight / 1.6
            local boxPos = Vector2.new(headScreen.X - boxWidth / 2, headScreen.Y)

            if Box_Enabled then
                objs.BoxOutline.Position = boxPos
                objs.BoxOutline.Size = Vector2.new(boxWidth, boxHeight)
                objs.BoxOutline.Visible = true

                objs.Box.Position = boxPos
                objs.Box.Size = Vector2.new(boxWidth, boxHeight)
                objs.Box.Visible = true

                local barWidth = 3
                local barOffset = 4
                local barPos = Vector2.new(boxPos.X + boxWidth + barOffset, boxPos.Y)

                objs.HealthBG.Position = barPos
                objs.HealthBG.Size = Vector2.new(barWidth, boxHeight)
                objs.HealthBG.Visible = true

                local hpPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                local fillHeight = boxHeight * hpPercent
                objs.HealthFill.Position = Vector2.new(barPos.X, barPos.Y + (boxHeight - fillHeight))
                objs.HealthFill.Size = Vector2.new(barWidth, fillHeight)
                objs.HealthFill.Color = Color3.fromRGB(255 * (1 - hpPercent), 255 * hpPercent, 0)
                objs.HealthFill.Visible = true
            else
                objs.Box.Visible = false
                objs.BoxOutline.Visible = false
                objs.HealthBG.Visible = false
                objs.HealthFill.Visible = false
            end

            if Tracers_Enabled then
                objs.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                objs.Tracer.To = Vector2.new(headScreen.X, legScreen.Y)
                objs.Tracer.Color = Color3.fromHSV(((tick() * RGB_Config.Speed) % 1), 1, 1)
                objs.Tracer.Visible = true
            else
                objs.Tracer.Visible = false
            end
            return
        end
    end

    objs.Box.Visible = false
    objs.BoxOutline.Visible = false
    objs.HealthBG.Visible = false
    objs.HealthFill.Visible = false
    objs.Tracer.Visible = false
end

local function UpdateHitbox(v)
    if v == LocalPlayer or not v.Character then return end
    local hrp = v.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        if Hitbox_Enabled then
            hrp.Size = Vector3.new(Hitbox_Size_Value, Hitbox_Size_Value, Hitbox_Size_Value)
            hrp.Transparency = 0.75
            hrp.BrickColor = BrickColor.new("Really red")
            hrp.Material = Enum.Material.Neon
            hrp.CanCollide = false
        else
            hrp.Size = Vector3.new(2, 2, 1)
            hrp.Transparency = 1
        end
    end
end

Players.PlayerRemoving:Connect(RemoveESPForPlayer)

-- ลูปการหมุนวนของสี RGB และอัปเดตตำแหน่ง ESP
RunService.RenderStepped:Connect(function()
    local colorSeq = GetCustomSequence(RGB_Config.Mode, 0)
    DynamicGradient.Color = colorSeq
    DynamicGradient.Rotation = (DynamicGradient.Rotation + (1.5 * RGB_Config.Speed)) % 360

    UIStrokeToggle.Color = colorSeq.Keypoints[1].Value
    EspUIStroke.Color = colorSeq.Keypoints[#colorSeq.Keypoints].Value

    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer then
            UpdateESP(v)
            UpdateHitbox(v)
        end
    end
end)

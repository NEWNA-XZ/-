local RGB_Config = {
    Speed = 1,          -- ความเร็วในการหมุนวนไฟ
    Size = 4,           -- ความหนาของเส้นขอบ (พิกเซล)
    Mode = "Rainbow",   -- โหมดสี: "Rainbow", "Green", "Cyan", "Fire"
    WaveIntensity = 0.5
}

-- ฟังก์ชั่นสร้างลำดับสี RGB แบบครบทุกเฉดสี
local function GetCustomSequence(mode, offset)
    local t = (tick() * RGB_Config.Speed * 0.2 + offset) % 1
    
    if mode == "Rainbow" then
        return ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, Color3.fromHSV((t) % 1, 1, 1)),
            ColorSequenceKeypoint.new(0.20, Color3.fromHSV((t + 0.2) % 1, 1, 1)),
            ColorSequenceKeypoint.new(0.40, Color3.fromHSV((t + 0.4) % 1, 1, 1)),
            ColorSequenceKeypoint.new(0.60, Color3.fromHSV((t + 0.6) % 1, 1, 1)),
            ColorSequenceKeypoint.new(0.80, Color3.fromHSV((t + 0.8) % 1, 1, 1)),
            ColorSequenceKeypoint.new(1.00, Color3.fromHSV((t + 1.0) % 1, 1, 1))
        })
    elseif mode == "Green" then
        return ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(0, 255, 128)),
            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 150, 50)),
            ColorSequenceKeypoint.new(0.66, Color3.fromRGB(100, 255, 200)),
            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(0, 255, 128))
        })
    elseif mode == "Cyan" then
        return ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(0, 230, 255)),
            ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 80, 255)),
            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(0, 230, 255))
        })
    elseif mode == "Fire" then
        return ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 30, 0)),
            ColorSequenceKeypoint.new(0.50, Color3.fromRGB(255, 200, 0)),
            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 30, 0))
        })
    end
end

